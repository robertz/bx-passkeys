/**
 * A CredentialStore over one table (see sql/ for its shape). Plain parameterized
 * SQL with no engine-specific functions, so it runs on MSSQL, MySQL, PostgreSQL,
 * Derby and the like.
 *
 *   new bxModules.bxPasskeys.models.TableCredentialStore( { datasource: "app", table: "passkey_credentials" } )
 */
class implements="CredentialStore" {

	static {
		COLUMNS = "credential_id, user_id, public_key, algorithm, sign_count, transports, name, created_at, last_used_at"
	}

	/** settings: { table = "passkey_credentials", datasource = the application's default } */
	function init( struct settings = {} ) {
		variables.table = arguments.settings.table ?: "passkey_credentials"
		if ( !reFind( "^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)?$", variables.table ) ) {
			throw( type = "Passkeys.Configuration", message = "The passkey table name '#variables.table#' isn't a plain identifier" )
		}
		variables.options = {}
		if ( !isNull( arguments.settings.datasource ) && ( !isSimpleValue( arguments.settings.datasource ) || len( arguments.settings.datasource ) ) ) {
			variables.options.datasource = arguments.settings.datasource
		}
		return this
	}

	function findByCredentialId( required string credentialId ) {
		var rows = run(
			"SELECT #static.COLUMNS# FROM #variables.table# WHERE credential_id = ?",
			[ { value: arguments.credentialId, sqltype: "varchar" } ]
		)
		return rows.len() ? toCredential( rows.first() ) : javacast( "null", "" )
	}

	array function listForUser( required string userId ) {
		return run(
			"SELECT #static.COLUMNS# FROM #variables.table# WHERE user_id = ? ORDER BY created_at DESC",
			[ { value: arguments.userId, sqltype: "varchar" } ]
		).map( ( row ) => toCredential( row ) )
	}

	void function add( required struct credential ) {
		var c = arguments.credential
		queryExecute(
			"INSERT INTO #variables.table# ( #static.COLUMNS# ) VALUES ( ?, ?, ?, ?, ?, ?, ?, ?, ? )",
			[
				{ value: c.credentialId, sqltype: "varchar" },
				{ value: toString( c.userId ), sqltype: "varchar" },
				{ value: c.publicKey, sqltype: "varchar" },
				{ value: c.algorithm, sqltype: "integer" },
				{ value: c.signCount, sqltype: "bigint" },
				{ value: arrayToList( c.transports ?: [] ), sqltype: "varchar" },
				{ value: c.name ?: "Passkey", sqltype: "nvarchar" },
				{ value: c.createdAt ?: now(), sqltype: "timestamp" },
				{ value: "", sqltype: "timestamp", null: isNull( c.lastUsedAt ) }
			],
			variables.options
		)
	}

	boolean function updateUsage( required string credentialId, required numeric signCount, required date lastUsedAt ) {
		var result = {}
		var params = [
			{ value: arguments.signCount, sqltype: "bigint" },
			{ value: arguments.lastUsedAt, sqltype: "timestamp" },
			{ value: arguments.credentialId, sqltype: "varchar" }
		]
		var guard = "sign_count = 0"
		if ( arguments.signCount > 0 ) {
			guard = "sign_count < ?"
			params.append( { value: arguments.signCount, sqltype: "bigint" } )
		}
		queryExecute(
			"UPDATE #variables.table# SET sign_count = ?, last_used_at = ? WHERE credential_id = ? AND #guard#",
			params,
			variables.options.copy().append( { result: "result" } )
		)
		return result.recordCount > 0
	}

	boolean function remove( required string credentialId ) {
		var result = {}
		queryExecute(
			"DELETE FROM #variables.table# WHERE credential_id = ?",
			[ { value: arguments.credentialId, sqltype: "varchar" } ],
			variables.options.copy().append( { result: "result" } )
		)
		return result.recordCount > 0
	}

	private array function run( required string sql, required array params ) {
		return queryExecute( arguments.sql, arguments.params, variables.options.copy().append( { returnType: "array" } ) )
	}

	private struct function toCredential( required struct row ) {
		return {
			credentialId : arguments.row.credential_id,
			userId       : toString( arguments.row.user_id ),
			publicKey    : arguments.row.public_key,
			algorithm    : val( arguments.row.algorithm ),
			signCount    : val( arguments.row.sign_count ),
			transports   : listToArray( arguments.row.transports ?: "" ),
			name         : arguments.row.name,
			createdAt    : arguments.row.created_at,
			lastUsedAt   : isDate( arguments.row.last_used_at ?: "" ) ? arguments.row.last_used_at : javacast( "null", "" )
		}
	}

}
