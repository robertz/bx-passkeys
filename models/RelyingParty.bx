/**
 * The server half of WebAuthn passkeys. Options are built here; every answer is
 * checked by webauthn4j (com.webauthn4j:webauthn4j-core, in libs/): client data,
 * origin, rpId hash, flags, attestation statement, algorithm and signature.
 * Attestation is "none": statements are checked for consistency, never against
 * a trust root.
 *
 * This class keeps what webauthn4j leaves to the caller: one-time challenges in
 * a session struct the caller passes in, one per purpose (registration, sign-in),
 * each good for one try within challengeSeconds; which user a passkey belongs to;
 * and a sign counter saved only while it moves forward.
 */
class {

	property name="settings";
	property name="store";

	static {
		MAX_CREDENTIAL_ID_BYTES = 1023
		MAX_FIELD_LENGTH = 16000
		MAX_TRANSPORTS = 10
		RANDOM = createObject( "java", "java.security.SecureRandom" ).init()
		URL_ENCODER = createObject( "java", "java.util.Base64" ).getUrlEncoder().withoutPadding()
		URL_DECODER = createObject( "java", "java.util.Base64" ).getUrlDecoder()
		// thread-safe; non-strict verifies attestation statements without needing trust anchors
		MANAGER = createObject( "java", "com.webauthn4j.WebAuthnManager" ).createNonStrictWebAuthnManager()
		// webauthn4j exception class -> what a person is told
		REASONS = {
			BadChallengeException               : "That answer is for another try. Try again.",
			MissingChallengeException           : "That answer is for another try. Try again.",
			BadOriginException                  : "That passkey was used on another site",
			BadTopOriginException               : "That passkey was used inside another site's frame",
			CrossOriginException                : "That passkey was used inside another site's frame",
			BadRpIdException                    : "That passkey is for another site",
			InconsistentClientDataTypeException : "The browser's answer is for something else",
			UserNotPresentException             : "The authenticator didn't confirm you were there",
			UserNotVerifiedException            : "The authenticator didn't confirm it was you",
			BadSignatureException               : "That passkey's signature doesn't check out",
			BadAttestationStatementException    : "The authenticator's answer doesn't add up",
			BadClientDataHashException          : "The authenticator's answer doesn't add up",
			PublicKeyMismatchException          : "That passkey's key doesn't match the authenticator's",
			NotAllowedAlgorithmException        : "That passkey uses a kind of key this site doesn't take",
			BadAlgorithmException               : "That passkey uses a kind of key this site doesn't take",
			MaliciousCounterValueException      : "That passkey looks copied. Remove it and add it again.",
			IllegalBackupStateException         : "The authenticator's answer doesn't add up",
			CredentialIdTooLongException        : "That passkey's id is too long",
			ConstraintViolationException        : "The authenticator's answer can't be read",
			DataConversionException             : "The authenticator's answer can't be read"
		}
		DEFAULTS = {
			rpId             : "localhost",
			rpName           : "",
			origins          : [],
			allowSubdomains  : false,
			challengeSeconds : 300,
			algorithms       : [ -7, -8, -257 ],
			userVerification : "preferred",
			residentKey      : "required",
			maxPerUser       : 0,
			sessionKey       : "passkeyChallenge"
		}
	}

	/**
	 * settings: see DEFAULTS and the README. store: a CredentialStore.
	 */
	function init( required struct settings, required store ) {
		variables.settings = duplicate( static.DEFAULTS ).append( arguments.settings )
		variables.store = arguments.store
		variables.settings.rpId = lcase( trim( variables.settings.rpId ) )
		if ( !len( variables.settings.rpId ) ) {
			throw( type = "Passkeys.Configuration", message = "rpId is required" )
		}
		if ( !len( variables.settings.rpName ) ) {
			variables.settings.rpName = variables.settings.rpId
		}
		if ( isSimpleValue( variables.settings.origins ) ) {
			variables.settings.origins = listToArray( variables.settings.origins )
		}
		variables.settings.origins = variables.settings.origins.map( ( o ) => lcase( reReplace( trim( o ), "/+$", "" ) ) )
		variables.settings.algorithms = variables.settings.algorithms.map( ( a ) => int( a ) )
		for ( var alg in variables.settings.algorithms ) {
			if ( !static.DEFAULTS.algorithms.contains( alg ) ) {
				throw( type = "Passkeys.Configuration", message = "Algorithm #alg# isn't supported; use -7, -8 or -257" )
			}
		}
		if ( ![ "required", "preferred", "discouraged" ].contains( variables.settings.userVerification ) ) {
			throw( type = "Passkeys.Configuration", message = "userVerification must be required, preferred or discouraged" )
		}
		if ( ![ "required", "preferred", "discouraged" ].contains( variables.settings.residentKey ) ) {
			throw( type = "Passkeys.Configuration", message = "residentKey must be required, preferred or discouraged" )
		}
		var parameters = createObject( "java", "java.util.ArrayList" ).init()
		var publicKeyType = createObject( "java", "com.webauthn4j.data.PublicKeyCredentialType" ).PUBLIC_KEY
		for ( var alg in variables.settings.algorithms ) {
			parameters.add(
				createObject( "java", "com.webauthn4j.data.PublicKeyCredentialParameters" ).init( publicKeyType, algorithmId( alg ) )
			)
		}
		variables.credentialParameters = parameters
		variables.allowedOrigins = createObject( "java", "java.util.HashSet" ).init()
		for ( var origin in variables.settings.origins ) {
			variables.allowedOrigins.add( originOf( origin ) )
		}
		variables.originPredicate = createDynamicProxy( new OriginCheck( this ), [ "com.webauthn4j.server.OriginPredicate" ] )
		return this
	}

	/**
	 * PublicKeyCredentialCreationOptionsJSON for a new passkey.
	 * user: { id, name, displayName? }. id is your app's user id; it's handed to the
	 * authenticator as its UTF-8 bytes, so keep names and emails out of it.
	 */
	struct function registrationOptions( required struct user, required struct sessionData ) {
		var userId = userIdOf( arguments.user )
		var existing = variables.store.listForUser( userId )
		if ( variables.settings.maxPerUser > 0 && existing.len() >= variables.settings.maxPerUser ) {
			invalid( "That's as many passkeys as an account can have. Remove one first." )
		}
		var name = toString( arguments.user.name ?: userId )
		var display = toString( arguments.user.displayName ?: "" )
		return {
			challenge              : newChallenge( arguments.sessionData, "register", userId ),
			rp                     : { id: variables.settings.rpId, name: variables.settings.rpName },
			user                   : { id: encode( userId.getBytes( "UTF-8" ) ), name: name, displayName: len( display ) ? display : name },
			pubKeyCredParams       : variables.settings.algorithms.map( ( alg ) => { return { type: "public-key", alg: alg } } ),
			timeout                : variables.settings.challengeSeconds * 1000,
			attestation            : "none",
			authenticatorSelection : {
				residentKey        : variables.settings.residentKey,
				requireResidentKey : variables.settings.residentKey == "required",
				userVerification   : variables.settings.userVerification
			},
			excludeCredentials : existing.map( ( c ) => descriptor( c ) )
		}
	}

	/**
	 * Checks the browser's answer and saves the new passkey; returns its credential struct
	 * with backupEligible and backedUp added. answer: { id, clientDataJSON, attestationObject,
	 * transports?: [], name?, publicKey?, publicKeyAlgorithm? }, binary
	 * fields base64url. The key is read from attestationObject; publicKey, when sent, must match it.
	 * Throws Passkeys.Invalid.
	 */
	struct function register( required struct user, required struct sessionData, required struct answer ) {
		var userId = userIdOf( arguments.user )
		var held = takeChallenge( arguments.sessionData, "register" )
		if ( compare( held.userId, userId ) != 0 ) {
			invalid( "That answer is for another account. Try again." )
		}
		var idBytes = decodeField( arguments.answer, "id" )
		if ( arrayLen( idBytes ) > static.MAX_CREDENTIAL_ID_BYTES ) {
			invalid( "That passkey's id is too long" )
		}
		var transports = transportsOf( arguments.answer.transports ?: "" )
		var registration = createObject( "java", "com.webauthn4j.data.RegistrationRequest" ).init(
			decodeField( arguments.answer, "attestationObject" ),
			decodeField( arguments.answer, "clientDataJSON" )
		)
		var parameters = createObject( "java", "com.webauthn4j.data.RegistrationParameters" ).init(
			serverProperty( held.value ),
			variables.credentialParameters,
			variables.settings.userVerification == "required",
			true
		)
		var data = webauthn( () => static.MANAGER.verify( registration, parameters ) )
		var authData = data.getAttestationObject().getAuthenticatorData()
		var attested = authData.getAttestedCredentialData()
		if ( isNull( attested ) || isNull( attested.getCOSEKey() ) ) {
			invalid( "That passkey came without its key" )
		}
		if ( !sameBytes( attested.getCredentialId(), idBytes ) ) {
			invalid( "That passkey's id doesn't match" )
		}
		var coseKey = attested.getCOSEKey()
		var algorithm = isNull( coseKey.getAlgorithm() ) ? 0 : coseKey.getAlgorithm().getValue()
		if ( !variables.settings.algorithms.contains( algorithm ) ) {
			invalid( "That passkey uses a kind of key this site doesn't take" )
		}
		var spki = coseKey.getPublicKey().getEncoded()
		if ( len( arguments.answer.publicKey ?: "" ) ) {
			if ( toString( arguments.answer.publicKeyAlgorithm ?: "" ) != toString( algorithm ) || !sameBytes( decodeField( arguments.answer, "publicKey" ), spki ) ) {
				invalid( "That passkey's key doesn't match the authenticator's" )
			}
		}

		var credentialId = encode( idBytes )
		var found = variables.store.findByCredentialId( credentialId )
		if ( !isNull( found ) ) {
			if ( compare( toString( found.userId ), userId ) != 0 ) {
				invalid( "That passkey is already in use" )
			}
			return duplicate( found ).append( { backupEligible: authData.isFlagBE(), backedUp: authData.isFlagBS() } )
		}
		if ( variables.settings.maxPerUser > 0 && variables.store.listForUser( userId ).len() >= variables.settings.maxPerUser ) {
			invalid( "That's as many passkeys as an account can have. Remove one first." )
		}
		var typed = isSimpleValue( arguments.answer.name ?: "" ) ? trim( arguments.answer.name ?: "" ) : ""
		var credential = {
			credentialId : credentialId,
			userId       : userId,
			publicKey    : encode( spki ),
			algorithm    : algorithm,
			signCount    : authData.getSignCount(),
			transports   : transports,
			name         : len( typed ) ? left( typed, 100 ) : "Passkey",
			createdAt    : now(),
			lastUsedAt   : javacast( "null", "" )
		}
		variables.store.add( credential )
		return duplicate( credential ).append( { backupEligible: authData.isFlagBE(), backedUp: authData.isFlagBS() } )
	}

	/**
	 * PublicKeyCredentialRequestOptionsJSON. With a userId only that user's passkeys
	 * are offered (re-confirming who's signed in); without one the browser offers
	 * whichever of this site's discoverable passkeys it has.
	 */
	struct function signInOptions( required struct sessionData, string userId = "" ) {
		var allowed = len( arguments.userId ) ? variables.store.listForUser( arguments.userId ).map( ( c ) => descriptor( c ) ) : []
		return {
			challenge        : newChallenge( arguments.sessionData, "sign-in", arguments.userId ),
			rpId             : variables.settings.rpId,
			timeout          : variables.settings.challengeSeconds * 1000,
			userVerification : variables.settings.userVerification,
			allowCredentials : allowed
		}
	}

	/**
	 * Checks a sign-in answer: { id, clientDataJSON, authenticatorData, signature, userHandle? }
	 * (base64url). Returns { userId, credentialId, userVerified, backupEligible, backedUp,
	 * signCount, credential }. When the options were made for a userId, the passkey must be theirs.
	 * Throws Passkeys.Invalid for anything that doesn't check out.
	 */
	struct function verify( required struct sessionData, required struct answer ) {
		var held = takeChallenge( arguments.sessionData, "sign-in" )
		var idBytes = decodeField( arguments.answer, "id" )
		var credential = variables.store.findByCredentialId( encode( idBytes ) )
		if ( isNull( credential ) ) {
			invalid( "That passkey isn't one this site knows. It may have been removed." )
		}
		var userId = toString( credential.userId )
		if ( len( held.userId ) && compare( held.userId, userId ) != 0 ) {
			invalid( "That passkey belongs to another account" )
		}
		var hasHandle = len( arguments.answer.userHandle ?: "" ) > 0
		if ( hasHandle ) {
			var handle = createObject( "java", "java.lang.String" ).init( decodeField( arguments.answer, "userHandle" ), "UTF-8" )
			if ( compare( handle, userId ) != 0 ) {
				invalid( "That passkey belongs to another account" )
			}
		}
		var algorithm = int( credential.algorithm )
		if ( !variables.settings.algorithms.contains( algorithm ) ) {
			invalid( "That passkey uses a kind of key this site doesn't take" )
		}
		var signIn = createObject( "java", "com.webauthn4j.data.AuthenticationRequest" ).init(
			idBytes,
			hasHandle ? decodeField( arguments.answer, "userHandle" ) : javacast( "null", "" ),
			decodeField( arguments.answer, "authenticatorData" ),
			decodeField( arguments.answer, "clientDataJSON" ),
			decodeField( arguments.answer, "signature" )
		)
		var parameters = createObject( "java", "com.webauthn4j.data.AuthenticationParameters" ).init(
			serverProperty( held.value ),
			credentialRecord( idBytes, credential ),
			javacast( "null", "" ),
			variables.settings.userVerification == "required",
			true
		)
		var data = webauthn( () => static.MANAGER.verify( signIn, parameters ) )
		var authData = data.getAuthenticatorData()

		var counter = authData.getSignCount()
		var usedAt = now()
		if ( !variables.store.updateUsage( credential.credentialId, counter, usedAt ) ) {
			invalid( "That passkey looks copied. Remove it and add it again." )
		}
		credential.signCount = counter
		credential.lastUsedAt = usedAt
		return {
			userId         : userId,
			credentialId   : credential.credentialId,
			userVerified   : authData.isFlagUV(),
			backupEligible : authData.isFlagBE(),
			backedUp       : authData.isFlagBS(),
			signCount      : counter,
			credential     : credential
		}
	}

	boolean function originAllowed( required string origin ) {
		var given = lcase( arguments.origin )
		if ( variables.settings.origins.len() ) {
			return variables.settings.origins.contains( given )
		}
		var found = reFind( "^(https?)://([^/:]+)(:[0-9]+)?$", given, 1, true )
		if ( !found.pos[ 1 ] ) {
			return false
		}
		var scheme = found.match[ 2 ]
		var host = found.match[ 3 ]
		var rpId = variables.settings.rpId
		if ( host != rpId && !( variables.settings.allowSubdomains && host.endsWith( "." & rpId ) ) ) {
			return false
		}
		return scheme == "https" || host == "localhost"
	}

	/** Runs a webauthn4j call, turning what it refuses into Passkeys.Invalid with a message a person can read. */
	private function webauthn( required function call ) {
		try {
			return arguments.call()
		} catch ( "Passkeys.Invalid" e ) {
			rethrow;
		} catch ( any e ) {
			// the call only reads what the browser sent, so anything else it throws is input it can't parse
			var reason = reasonFor( e )
			invalid( len( reason ) ? reason : "The authenticator's answer can't be read" )
		}
	}

	/** The message for the first webauthn4j or Jackson refusal in the exception's chain, or "" when there's none. */
	private string function reasonFor( required e ) {
		var cause = isInstanceOf( arguments.e, "java.lang.Throwable" ) ? arguments.e : ( arguments.e.cause ?: javacast( "null", "" ) )
		var depth = 0
		while ( !isNull( cause ) && depth < 10 ) {
			var type = cause.getClass()
			if ( type.getName().startsWith( "tools.jackson." ) ) {
				return "The authenticator's answer can't be read"
			}
			while ( !isNull( type ) && type.getName().startsWith( "com.webauthn4j." ) ) {
				if ( static.REASONS.keyExists( type.getSimpleName() ) ) {
					return static.REASONS[ type.getSimpleName() ]
				}
				if ( type.getSimpleName() == "VerificationException" ) {
					return "That passkey's answer doesn't check out"
				}
				type = type.getSuperclass()
			}
			cause = cause.getCause()
			depth++
		}
		return ""
	}

	private function serverProperty( required string challenge ) {
		var builder = createObject( "java", "com.webauthn4j.server.ServerProperty" ).builder()
			.rpId( variables.settings.rpId )
			.challenge( createObject( "java", "com.webauthn4j.data.client.challenge.DefaultChallenge" ).init( arguments.challenge ) )
		if ( variables.allowedOrigins.size() ) {
			builder.origins( variables.allowedOrigins )
		} else {
			builder.originPredicate( variables.originPredicate )
		}
		return builder.build()
	}

	/** A configured origin as webauthn4j's Origin; Passkeys.Configuration unless it's scheme://host[:port] or an Android app origin. */
	private function originOf( required string origin ) {
		if ( !reFind( "^(https?://[^/?##\s]+|android:apk-key-hash:[A-Za-z0-9_-]+)$", arguments.origin ) ) {
			throw( type = "Passkeys.Configuration", message = "The origin '#arguments.origin#' isn't scheme://host[:port]" )
		}
		try {
			return createObject( "java", "com.webauthn4j.data.client.Origin" ).create( arguments.origin )
		} catch ( any e ) {
			throw( type = "Passkeys.Configuration", message = "The origin '#arguments.origin#' can't be read" )
		}
	}

	/** What webauthn4j needs to check a sign-in, rebuilt from the stored SPKI key. */
	private function credentialRecord( required idBytes, required struct credential ) {
		var algorithm = int( arguments.credential.algorithm )
		var coseKey = ""
		try {
			var publicKey = createObject( "java", "java.security.KeyFactory" )
				.getInstance( algorithm == -8 ? "Ed25519" : ( algorithm == -257 ? "RSA" : "EC" ) )
				.generatePublic( createObject( "java", "java.security.spec.X509EncodedKeySpec" ).init( decode( arguments.credential.publicKey ) ) )
			var keyClass = algorithm == -8 ? "EdDSACOSEKey" : ( algorithm == -257 ? "RSACOSEKey" : "EC2COSEKey" )
			coseKey = createObject( "java", "com.webauthn4j.data.attestation.authenticator.#keyClass#" ).create( publicKey, algorithmId( algorithm ) )
		} catch ( any e ) {
			invalid( "That passkey's key on file can't be read" )
		}
		var attested = createObject( "java", "com.webauthn4j.data.attestation.authenticator.AttestedCredentialData" ).init(
			createObject( "java", "com.webauthn4j.data.attestation.authenticator.AAGUID" ).ZERO,
			arguments.idBytes,
			coseKey
		)
		return createObject( "java", "com.webauthn4j.credential.CredentialRecordImpl" ).init(
			createObject( "java", "com.webauthn4j.data.attestation.statement.NoneAttestationStatement" ).init(),
			javacast( "null", "" ),
			javacast( "null", "" ),
			javacast( "null", "" ),
			javacast( "long", arguments.credential.signCount ),
			attested,
			javacast( "null", "" ),
			javacast( "null", "" ),
			javacast( "null", "" ),
			javacast( "null", "" )
		)
	}

	private function algorithmId( required numeric alg ) {
		return createObject( "java", "com.webauthn4j.data.attestation.statement.COSEAlgorithmIdentifier" ).create( javacast( "long", arguments.alg ) )
	}

	private array function transportsOf( required value ) {
		var transports = []
		for ( var t in ( isArray( arguments.value ) ? arguments.value : [] ) ) {
			if ( transports.len() < static.MAX_TRANSPORTS && isSimpleValue( t ) && reFind( "^[a-z-]{1,20}$", t ) && !transports.contains( t ) ) {
				transports.append( t )
			}
		}
		return transports
	}

	private struct function descriptor( required struct credential ) {
		return { type: "public-key", id: arguments.credential.credentialId, transports: arguments.credential.transports ?: [] }
	}

	private string function userIdOf( required struct user ) {
		var id = arguments.user.id ?: ""
		if ( !isSimpleValue( id ) || !len( toString( id ) ) || len( toString( id ).getBytes( "UTF-8" ) ) > 64 ) {
			throw( type = "Passkeys.Configuration", message = "user.id must be 1 to 64 bytes" )
		}
		return toString( id )
	}

	private string function newChallenge( required struct sessionData, required string purpose, required string userId ) {
		var bytes = createObject( "java", "java.nio.ByteBuffer" ).allocate( 32 ).array()
		static.RANDOM.nextBytes( bytes )
		var value = encode( bytes )
		var key = variables.settings.sessionKey
		lock name=challengeLock( arguments.sessionData ) type="exclusive" timeout=5 {
			var slots = arguments.sessionData[ key ] ?: {}
			if ( !isStruct( slots ) ) {
				slots = {}
			}
			slots[ arguments.purpose ] = {
				value   : value,
				purpose : arguments.purpose,
				userId  : arguments.userId,
				expires : now().getTime() + variables.settings.challengeSeconds * 1000
			}
			arguments.sessionData[ key ] = slots
		}
		return value
	}

	/** The session's challenge for this purpose, used up whatever happens next. */
	private struct function takeChallenge( required struct sessionData, required string purpose ) {
		var held = {}
		var key = variables.settings.sessionKey
		lock name=challengeLock( arguments.sessionData ) type="exclusive" timeout=5 {
			var slots = arguments.sessionData[ key ] ?: {}
			if ( isStruct( slots ) ) {
				held = slots[ arguments.purpose ] ?: {}
				slots.delete( arguments.purpose )
				arguments.sessionData[ key ] = slots
			}
		}
		if ( !isStruct( held ) || ( held.purpose ?: "" ) != arguments.purpose ) {
			invalid( "That answer was already used, or never asked for. Try again." )
		}
		if ( ( held.expires ?: 0 ) < now().getTime() ) {
			invalid( "That took too long. Try again." )
		}
		return held
	}

	/** Serializes challenge reads and writes on one session struct, so a challenge can't be taken twice. */
	private string function challengeLock( required struct sessionData ) {
		return "bxPasskeys.challenge." & createObject( "java", "java.lang.System" ).identityHashCode( arguments.sessionData )
	}

	private string function requireField( required struct answer, required string name ) {
		var value = arguments.answer[ arguments.name ] ?: ""
		if ( !isSimpleValue( value ) || !len( value ) || len( value ) > static.MAX_FIELD_LENGTH ) {
			invalid( "The browser's answer is missing #arguments.name#" )
		}
		return value
	}

	private function decodeField( required struct answer, required string name ) {
		return decode( requireField( arguments.answer, arguments.name ) )
	}

	private function decode( required string value ) {
		try {
			return static.URL_DECODER.decode( reReplace( arguments.value, "=+$", "" ) )
		} catch ( any e ) {
			invalid( "The browser's answer can't be read" )
		}
	}

	private string function encode( required bytes ) {
		return static.URL_ENCODER.encodeToString( arguments.bytes )
	}

	private boolean function sameBytes( required a, required b ) {
		return createObject( "java", "java.security.MessageDigest" ).isEqual( arguments.a, arguments.b )
	}

	private void function invalid( required string message ) {
		throw( type = "Passkeys.Invalid", message = arguments.message )
	}

}
