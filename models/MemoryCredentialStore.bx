/** A CredentialStore in a struct: for tests, demos and single-process prototypes. */
class implements="CredentialStore" {

	function init() {
		variables.credentials = structNew( "ordered" )
		variables.lock = createUUID()
		return this
	}

	function findByCredentialId( required string credentialId ) {
		if ( !variables.credentials.keyExists( arguments.credentialId ) ) {
			return javacast( "null", "" )
		}
		return duplicate( variables.credentials[ arguments.credentialId ] )
	}

	array function listForUser( required string userId ) {
		var wanted = arguments.userId
		return variables.credentials.valueArray()
			.filter( ( c ) => c.userId == wanted )
			.reverse()
			.map( ( c ) => duplicate( c ) )
	}

	void function add( required struct credential ) {
		lock name=variables.lock type="exclusive" timeout=5 {
			variables.credentials[ arguments.credential.credentialId ] = duplicate( arguments.credential )
		}
	}

	void function updateUsage( required string credentialId, required numeric signCount, required date lastUsedAt ) {
		lock name=variables.lock type="exclusive" timeout=5 {
			if ( variables.credentials.keyExists( arguments.credentialId ) ) {
				variables.credentials[ arguments.credentialId ].signCount = arguments.signCount
				variables.credentials[ arguments.credentialId ].lastUsedAt = arguments.lastUsedAt
			}
		}
	}

	boolean function remove( required string credentialId ) {
		lock name=variables.lock type="exclusive" timeout=5 {
			var had = variables.credentials.keyExists( arguments.credentialId )
			structDelete( variables.credentials, arguments.credentialId )
			return had
		}
	}

}
