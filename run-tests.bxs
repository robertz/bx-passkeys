/**
 * Runs the specs headlessly and exits non-zero on any failure or error.
 *   bash scripts/test.sh   (runs this in the test home)
 */
if ( !createObject( "java", "java.nio.file.Files" ).exists( createObject( "java", "java.nio.file.Paths" ).get( expandPath( ".tmp/bxhome/modules/bx-passkeys" ) ), [] ) ) {
	println( "Run `bash scripts/test.sh`, which sets up the test home first." )
	createObject( "java", "java.lang.System" ).exit( 1 )
}

tb = new "testbox.system.TestBox"( directory = "tests.specs", reporter = "text" )
println( tb.run() )

result = tb.getResult()
if ( result.getTotalFail() > 0 || result.getTotalError() > 0 ) {
	createObject( "java", "java.lang.System" ).exit( 1 )
}
