/**
 * Once per checkout: makes .tmp/bxhome, a BoxLang home of its own for the specs,
 * whose modules are this folder (as bxPasskeys) and bx-derby. A home of its own
 * so a bx-passkeys installed in ~/.boxlang/modules can't stand in for this checkout.
 *
 *   boxlang setup-tests.bxs
 *   bash scripts/test.sh
 */
paths = createObject( "java", "java.nio.file.Paths" )
files = createObject( "java", "java.nio.file.Files" )
modules = paths.get( expandPath( ".tmp/bxhome/modules" ) )
files.createDirectories( modules )
linkPath = modules.resolve( "bx-passkeys" )
if ( !files.exists( linkPath, [] ) ) {
	files.createSymbolicLink( linkPath, paths.get( "../../.." ) )
}
derby = paths.get( expandPath( "boxlang_modules/bx-derby" ) )
if ( !files.exists( derby, [] ) ) {
	println( "bx-derby is missing: run `box install` first, then this again." )
	createObject( "java", "java.lang.System" ).exit( 1 )
}
println( "Test home ready in .tmp/bxhome. Run `bash scripts/test.sh` now." )
