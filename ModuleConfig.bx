/**
 * bx-passkeys: WebAuthn passkeys for BoxLang, verified by webauthn4j (jars in libs/).
 * Settings go in boxlang.json under modules.bxPasskeys.settings, or straight
 * to passkeyRelyingParty() / new RelyingParty().
 */
class {

	this.version     = "0.3.1";
	this.mapping     = "bxPasskeys";
	this.author      = "Robert Zehnder";
	this.description = "WebAuthn passkeys (registration and sign-in) for BoxLang, verified by webauthn4j.";
	this.webURL      = "https://github.com/robertz/bx-passkeys";
	this.enabled     = true;

	function configure() {
		// every other setting defaults in RelyingParty's DEFAULTS
		settings = {
			store : { table: "passkey_credentials", datasource: "" }
		};
	}

	function onLoad() {
	}

	function onUnload() {
	}

}
